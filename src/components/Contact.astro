---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="contact" title={t("contact.title")}>
  <p class="max-w-[36rem] text-lg leading-relaxed text-ink-2">{t("contact.text")}</p>
  <p class="mt-6">
    <a
      href="mailto:ondrej.bassler@gmail.com"
      class="break-all text-[clamp(1.5rem,4.5vw,2.75rem)] font-bold tracking-tight text-ink decoration-water decoration-2 hover:text-water"
    >ondrej.bassler@gmail.com</a>
  </p>
  <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3 text-[0.9375rem]">
    <div>
      <dt class="text-ink-3">{t("contact.phone")}</dt>
      <dd><a href="tel:+420737018693" class="tnum text-ink no-underline hover:underline">+420 737 018 693</a></dd>
    </div>
    <div>
      <dt class="text-ink-3">GitHub</dt>
      <dd><a href="https://github.com/obassler" class="text-ink no-underline hover:underline">github.com/obassler</a></dd>
    </div>
  </dl>
</Section>
