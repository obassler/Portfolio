---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Section from "./Section.astro";
import data from "@/data/thesis.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pct = (v: number, d = 1) =>
  (v * 100).toLocaleString(lang === "cs" ? "cs-CZ" : "en-US", { minimumFractionDigits: d, maximumFractionDigits: d }) + " %";

const classes = [...data.perClass].sort((a, b) => b.contested - a.contested);
const maxC = classes[0].contested;

const stats = [
  { v: pct(data.stats.mean), l: t("thesis.stat.agree") },
  { v: `${pct(data.stats.min)} – ${pct(data.stats.max)}`, l: t("thesis.stat.range") },
  { v: pct(data.stats.unanimous, 0), l: t("thesis.stat.unan") },
];

const ramp = ["#120a0b", "#3b0d16", "#7a1022", "#b8162e", "#e2492f", "#f0883a", "#f5c45e", "#fbeec0"];
const fmt = (v: number, d: number) => v.toLocaleString(lang === "cs" ? "cs-CZ" : "en-US", { minimumFractionDigits: d, maximumFractionDigits: d });

const payload = JSON.stringify({
  m: data.corr,
  a: data.agreement,
  min: data.corrStats.min,
  max: data.corrStats.max,
  ramp,
  pair: t("thesis.matrix.pair"),
  hint: t("thesis.matrix.hint"),
  locale: lang === "cs" ? "cs-CZ" : "en-US",
});
---

<Section id="thesis" kicker={t("thesis.kicker")} title={t("thesis.title")}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14">
    <div class="reveal">
      <p class="max-w-[36rem] text-lg leading-relaxed text-cream-2">{t("thesis.p1")}</p>
      <p class="mt-5 max-w-[36rem] leading-relaxed text-cream-2">{t("thesis.p2")}</p>

      <dl class="mt-10 space-y-6">
        {stats.map((s) => (
          <div>
            <dt class="sr-only">{s.l}</dt>
            <dd>
              <span class="tnum block font-display text-[clamp(1.75rem,3.4vw,2.5rem)] font-semibold tracking-tight">{s.v}</span>
              <span class="text-[0.9375rem] text-cream-3">{s.l}</span>
            </dd>
          </div>
        ))}
      </dl>

      <p class="mt-10 text-[0.9375rem] text-cream-3">{t("thesis.stack")}</p>
      <p class="mt-4">
        <a href="https://github.com/obassler/FashionMnist-OSU" class="btn btn-glass glass">{t("thesis.code")}</a>
      </p>
    </div>

    <figure class="reveal glass m-0 self-start rounded-3xl p-4 sm:p-6">
      <figcaption class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <span class="font-display text-lg font-semibold">{t("thesis.matrix.label")}</span>
        <span class="flex items-center gap-2 text-[0.8125rem] text-cream-3">
          <span class="tnum">{fmt(data.corrStats.min, 3)}</span>
          <span class="h-2 w-24 rounded-full" style={`background:linear-gradient(90deg,${ramp.join(",")})`}></span>
          <span class="tnum">{fmt(data.corrStats.max, 3)}</span>
        </span>
      </figcaption>
      <div class="relative">
        <canvas
          id="agree-canvas"
          data-payload={payload}
          role="img"
          aria-label={`${t("thesis.matrix.label")}: ${stats[0].v} ${stats[0].l}`}
          class="block aspect-square w-full touch-none rounded-xl"
        ></canvas>
      </div>
      <p id="agree-readout" class="tnum mt-4 min-h-[1.6em] text-[0.9375rem] text-cream-2" aria-live="polite">{t("thesis.matrix.hint")}</p>
    </figure>
  </div>

  <div class="reveal mt-16">
    <h3 class="text-2xl font-semibold tracking-tight">{t("thesis.classes")}</h3>
    <p class="mt-2 text-[0.9375rem] text-cream-3">{t("thesis.classes.note")}</p>
    <ol class="mt-6 grid gap-x-12 gap-y-3 md:grid-cols-2">
      {classes.map((c) => (
        <li class="grid grid-cols-[7.5rem_minmax(0,1fr)_3.5rem] items-center gap-3 text-[0.9375rem]">
          <span class="text-cream-2">{c.cls}</span>
          <span class="h-2 overflow-hidden rounded-full bg-white/5">
            <span class="block h-full rounded-full" style={`width:${(c.contested / maxC) * 100}%;background:${c === classes[0] ? "var(--color-crimson)" : "rgb(242 236 228 / 0.35)"}`}></span>
          </span>
          <span class="tnum text-right text-cream">{pct(c.contested, 0)}</span>
        </li>
      ))}
    </ol>
  </div>
</Section>

<script>
  type Payload = { m: number[][]; a: number[][]; min: number; max: number; ramp: string[]; pair: string; hint: string; locale: string };
  const canvas = document.getElementById("agree-canvas") as HTMLCanvasElement | null;
  const readout = document.getElementById("agree-readout");
  if (canvas && readout) {
    const p: Payload = JSON.parse(canvas.dataset.payload!);
    const n = p.m.length;
    const ctx = canvas.getContext("2d")!;
    const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const stops = p.ramp.map(hex);
    const color = (v: number) => {
      const t = Math.min(1, Math.max(0, (v / 10000 - p.min) / (p.max - p.min)));
      const x = t * (stops.length - 1);
      const k = Math.min(stops.length - 2, Math.floor(x));
      const f = x - k;
      const [a, b] = [stops[k], stops[k + 1]];
      return `rgb(${a[0] + (b[0] - a[0]) * f},${a[1] + (b[1] - a[1]) * f},${a[2] + (b[2] - a[2]) * f})`;
    };

    let hover: [number, number] | null = null;
    let size = 0;

    const draw = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      size = canvas.clientWidth;
      canvas.width = canvas.height = Math.round(size * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const c = size / n;
      for (let i = 0; i < n; i++) {
        for (let j = 0; j < n; j++) {
          ctx.fillStyle = i === j ? p.ramp[p.ramp.length - 1] : color(p.m[i][j]);
          ctx.fillRect(j * c, i * c, Math.ceil(c), Math.ceil(c));
        }
      }
      if (hover) {
        const [i, j] = hover;
        ctx.fillStyle = "rgba(12,10,10,0.45)";
        ctx.fillRect(0, i * c, size, c);
        ctx.fillRect(j * c, 0, c, size);
        ctx.strokeStyle = "#f2ece4";
        ctx.lineWidth = 1.5;
        ctx.strokeRect(j * c - 1, i * c - 1, c + 2, c + 2);
      }
    };

    const pick = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      const j = Math.floor(((e.clientX - r.left) / r.width) * n);
      const i = Math.floor(((e.clientY - r.top) / r.height) * n);
      if (i < 0 || j < 0 || i >= n || j >= n) return;
      hover = [i, j];
      const corr = i === j ? 1 : p.m[i][j] / 10000;
      const ag = i === j ? 100 : p.a[i][j] / 10;
      const nf = (v: number, d: number) => v.toLocaleString(p.locale, { minimumFractionDigits: d, maximumFractionDigits: d });
      readout.textContent = p.pair.replace("{a}", String(i)).replace("{b}", String(j)).replace("{r}", nf(corr, 4)).replace("{v}", nf(ag, 1) + " %");
      draw();
    };

    canvas.addEventListener("pointermove", pick);
    canvas.addEventListener("pointerdown", pick);
    canvas.addEventListener("pointerleave", () => {
      hover = null;
      readout.textContent = p.hint;
      draw();
    });
    new ResizeObserver(draw).observe(canvas);
  }
</script>
