---
import type { Lang } from "@/i18n/ui";
import { useTranslations, getLocalizedPath, getAlternateLanguage } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = getAlternateLanguage(lang);

const links = [
  { href: "#work", label: t("nav.work") },
  { href: "#projects", label: t("nav.projects") },
  { href: "#skills", label: t("nav.skills") },
  { href: "#contact", label: t("nav.contact") },
];
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-8">
    <a href={getLocalizedPath(lang)} class="font-semibold tracking-tight text-ink no-underline">
      Ondřej Bassler
    </a>

    <nav aria-label="Main" class="ml-auto hidden gap-6 text-[0.9375rem] text-ink-2 md:flex">
      {links.map((l) => (
        <a href={l.href} class="no-underline hover:text-ink hover:underline">{l.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-2">
      <a
        href={getLocalizedPath(alt)}
        hreflang={alt}
        lang={alt}
        aria-label={t("lang.switch.label")}
        class="rounded px-2 py-1 text-[0.9375rem] text-ink-2 no-underline hover:text-ink hover:underline"
      >{t("lang.switch")}</a>

      <button
        id="theme-toggle"
        type="button"
        aria-label={t("theme.toggle")}
        class="grid h-9 w-9 place-items-center rounded text-ink-2 hover:text-ink"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
</script>
