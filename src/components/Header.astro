---
import type { Lang } from "@/i18n/ui";
import { useTranslations, getLocalizedPath, getAlternateLanguage } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = getAlternateLanguage(lang);

const links = [
  { href: "#thesis", label: t("nav.thesis") },
  { href: "#projects", label: t("nav.projects") },
  { href: "#work", label: t("nav.work") },
  { href: "#contact", label: t("nav.contact") },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-4">
  <div class="glass mx-auto flex h-14 !bg-night/70 max-w-6xl items-center gap-4 rounded-full pl-5 pr-2 sm:pl-6">
    <a href={getLocalizedPath(lang)} class="font-display text-[0.95rem] font-semibold tracking-tight text-cream no-underline">
      Ondřej Bassler
    </a>

    <nav aria-label="Main" class="ml-auto hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a href={l.href} class="rounded-full px-3.5 py-2 text-[0.9rem] text-cream-2 no-underline transition-colors hover:bg-white/5 hover:text-cream">{l.label}</a>
      ))}
    </nav>

    <a
      href={getLocalizedPath(alt)}
      hreflang={alt}
      lang={alt}
      aria-label={t("lang.switch.label")}
      class="ml-auto grid h-10 min-w-10 place-items-center rounded-full border border-white/10 px-3 text-[0.85rem] font-medium text-cream-2 no-underline transition-colors hover:border-gold/50 hover:text-cream md:ml-2"
    >{t("lang.switch")}</a>
  </div>
</header>
