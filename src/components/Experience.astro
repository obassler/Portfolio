---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { experience } from "@/data/experience";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="work" title={t("work.title")}>
  <ol class="space-y-10">
    {experience.map((job) => (
      <li class="grid gap-x-8 gap-y-1 sm:grid-cols-[10rem_minmax(0,1fr)]">
        <p class="tnum pt-0.5 text-[0.9375rem] text-ink-3">{job.period[lang]}</p>
        <div>
          <h3 class="text-lg font-semibold leading-snug">{job.company}</h3>
          <p class="text-ink-2">{job.role[lang]}</p>
          <ul class="mt-3 max-w-[40rem] list-disc space-y-1.5 pl-5 leading-relaxed text-ink-2 marker:text-ink-3">
            {job.points.map((pt) => <li>{pt[lang]}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>
