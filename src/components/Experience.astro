---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { experience } from "@/data/experience";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="work" title={t("work.title")}>
  <ol class="relative border-l border-line pl-6 sm:pl-10">
    {experience.map((job, i) => (
      <li class="reveal relative pb-12 last:pb-0">
        <span
          class={`absolute -left-[calc(1.5rem+5px)] top-2 h-2.5 w-2.5 rounded-full sm:-left-[calc(2.5rem+5px)] ${i === 0 ? "bg-crimson shadow-[0_0_0_4px_rgb(200_16_46/0.2)]" : "bg-cream-3"}`}
          aria-hidden="true"
        ></span>
        <p class="tnum text-[0.875rem] text-gold">{job.period[lang]}</p>
        <h3 class="mt-1 text-xl font-semibold tracking-tight sm:text-2xl">{job.company}</h3>
        <p class="text-cream-2">{job.role[lang]}</p>
        <ul class="mt-4 max-w-[44rem] space-y-2 leading-relaxed text-cream-2">
          {job.points.map((pt) => (
            <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-cream-3">{pt[lang]}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>
