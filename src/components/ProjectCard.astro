---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import type { Project } from "@/data/projects";
import { Icon } from "astro-icon/components";

interface Props {
  project: Project;
  lang: Lang;
  delay?: number;
}

const { project, lang, delay = 0 } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="scroll-reveal group flex flex-col rounded-xl border border-border bg-bg-card transition-all hover:border-pink/40 hover:shadow-lg hover:shadow-pink/5"
  data-delay={delay}
>
  <!-- Icon header -->
  <div class="relative flex h-32 items-center justify-center overflow-hidden rounded-t-xl bg-gradient-to-br from-pink/10 via-purple/10 to-teal/10">
    <Icon name={project.icon} class="h-12 w-12 text-pink/60 transition-transform duration-300 group-hover:scale-110" />
    <div class="absolute inset-0 bg-gradient-to-t from-bg-card/40 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-5">
    <h3 class="mb-2 text-lg font-semibold text-text-primary">
      {project.title[lang]}
    </h3>

    <p class="mb-4 flex-1 text-sm leading-relaxed text-text-muted">
      {project.description[lang]}
    </p>

    <!-- Tags -->
    <div class="mb-4 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <span class="rounded-full bg-pink/10 px-2.5 py-0.5 text-xs font-medium text-pink">
          {tag}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex items-center gap-3">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-text-secondary transition-colors hover:text-pink"
        >
          <Icon name="simple-icons:github" class="h-4 w-4" />
          {t("projects.viewCode")}
        </a>
      )}
      {project.live && (
        <a
          href={project.live}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-text-secondary transition-colors hover:text-pink"
        >
          <Icon name="lucide:external-link" class="h-4 w-4" />
          {t("projects.liveDemo")}
        </a>
      )}
    </div>
  </div>
</div>
