---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import HeroScene from "./HeroScene";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = lang === "cs" ? "/cv/ondrej-bassler-cv.pdf" : "/cv/ondrej-bassler-cv-en.pdf";

---

<section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden">
  <!-- light pools + 3D scene -->
  <div class="ambient pointer-events-none absolute inset-0 -z-20"></div>
  <div class="absolute inset-0 -z-10 lg:left-[38%] max-lg:top-[46%] max-lg:opacity-35">
    <HeroScene client:only="react" />
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-night to-transparent"></div>

  <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-5 pb-24 pt-32 sm:px-8">
    <h1
      class="rise max-w-[13ch] text-[clamp(2.75rem,7.2vw,6rem)] font-semibold leading-[0.98] tracking-[-0.035em]"
      style="--i:0"
    >{t("hero.title")}</h1>

    <p class="rise mt-7 max-w-[38rem] text-[1.0625rem] leading-relaxed text-cream-2 sm:text-lg" style="--i:1">
      {t("hero.lead")}
    </p>

    <div class="rise mt-9 flex flex-wrap gap-3" style="--i:2">
      <a href="#thesis" class="btn btn-primary">{t("hero.cta.work")}</a>
      <a href={cv} download class="btn btn-glass glass">{t("hero.cta.cv")}</a>
    </div>
  </div>

</section>
