---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { Icon } from "astro-icon/components";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 pt-16">
  <!-- Background gradient decoration -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-pink/10 blur-[120px]"></div>
    <div class="absolute -right-32 bottom-0 h-80 w-80 rounded-full bg-purple/10 blur-[100px]"></div>
    <div class="absolute bottom-32 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-teal/8 blur-[80px]"></div>
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <!-- Greeting -->
    <div class="scroll-reveal mb-4">
      <span class="font-mono text-sm text-pink">{t("hero.greeting")}</span>
    </div>

    <!-- Name -->
    <h1 class="scroll-reveal mb-4 text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl" data-delay="1">
      <span class="gradient-text">{t("hero.name")}</span>
    </h1>

    <!-- Title -->
    <h2 class="scroll-reveal mb-6 text-xl font-medium text-text-secondary sm:text-2xl" data-delay="2">
      {t("hero.title")}
    </h2>

    <!-- Subtitle -->
    <p class="scroll-reveal mx-auto mb-10 max-w-xl text-text-muted" data-delay="3">
      {t("hero.subtitle")}
    </p>

    <!-- CTAs -->
    <div class="scroll-reveal flex flex-wrap items-center justify-center gap-4" data-delay="4">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-lg bg-pink px-6 py-3 text-sm font-medium text-white transition-all hover:bg-pink/90 hover:shadow-lg hover:shadow-pink/25"
      >
        <Icon name="lucide:folder-open" class="h-4 w-4" />
        {t("hero.cta.projects")}
      </a>
      <a
        href="/cv/ondrej-bassler-cv.pdf"
        download
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-medium text-text-secondary transition-all hover:border-pink hover:text-pink"
      >
        <Icon name="lucide:download" class="h-4 w-4" />
        {t("hero.cta.cv")}
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-reveal mt-16 animate-bounce" data-delay="5">
      <Icon name="lucide:chevron-down" class="mx-auto h-5 w-5 text-text-muted" />
    </div>
  </div>
</section>
