---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { contours, descent, globalMin, W, H } from "@/lib/landscape";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lines = contours(14);
const path = descent();
const gmin = globalMin();
const cv = lang === "cs" ? "/cv/ondrej-bassler-cv.pdf" : "/cv/ondrej-bassler-cv-en.pdf";
---

<section class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 pt-12 sm:px-8 md:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-center lg:gap-14">
  <div>
    <h1 class="text-[clamp(2.75rem,8vw,5.25rem)] font-extrabold leading-[0.95] tracking-[-0.035em]">
      Ondřej<br />Bassler
    </h1>
    <p class="mt-3 text-xl font-medium text-ink-2">Software Developer</p>

    <p class="mt-8 max-w-[34rem] text-lg leading-relaxed text-ink-2">{t("hero.lead")}</p>

    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-[0.9375rem]">
      <li>
        <a href={cv} download class="inline-block rounded bg-ink px-4 py-2.5 font-medium text-paper no-underline hover:bg-water">
          {t("hero.cv")}
        </a>
      </li>
      <li class="self-center">
        <a href="https://github.com/obassler" class="text-water underline">github.com/obassler</a>
      </li>
      <li class="self-center">
        <a href="mailto:ondrej.bassler@gmail.com" class="text-water underline">ondrej.bassler@gmail.com</a>
      </li>
    </ul>
    <p class="mt-6 text-sm text-ink-3">{t("hero.location")}</p>
  </div>

  <figure class="m-0">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={t("hero.figure.label")}
      class="block h-auto w-full"
    >
      <g fill="none" stroke-linecap="round">
        {lines.map((c) => (
          <path
            d={c.d}
            stroke="var(--color-contour)"
            stroke-width={c.level % 4 === 3 ? 1.4 : 0.8}
            opacity={c.level % 4 === 3 ? 0.95 : 0.7}
          />
        ))}
      </g>

      <circle cx={path.start[0]} cy={path.start[1]} r="4" fill="var(--color-paper)" stroke="var(--color-water)" stroke-width="2" />
      <text class="map-label fill-ink-2" x={path.start[0] + 10} y={path.start[1] + 4} font-size="16">{t("hero.figure.start")}</text>

      <path
        d={path.d}
        class="descent-path"
        style={`--len:${path.length}`}
        fill="none"
        stroke="var(--color-water)"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <g class="fill-ink-3 text-ink-3">
        <path d={`M${gmin[0] - 6} ${gmin[1]}h12M${gmin[0]} ${gmin[1] - 6}v12`} stroke="currentColor" stroke-width="1.5" />
        <text class="map-label" x={gmin[0]} y={gmin[1] + 28} text-anchor="middle" font-size="16">{t("hero.figure.global")}</text>
      </g>

      <g class="descent-end">
        <circle cx={path.end[0]} cy={path.end[1]} r="6" fill="var(--color-marker)" />
        <circle cx={path.end[0]} cy={path.end[1]} r="11" fill="none" stroke="var(--color-marker)" stroke-width="1.25" />
        <text class="map-label fill-ink" x={path.end[0] - 18} y={path.end[1] - 16} text-anchor="end" font-size="16" font-weight="600">{t("hero.figure.min")}</text>
      </g>
    </svg>
    <figcaption class="mt-3 max-w-[36rem] text-sm leading-relaxed text-ink-3">{t("hero.figure")}</figcaption>
  </figure>
</section>
