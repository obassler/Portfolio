---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { education, certificates } from "@/data/education";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="education" title={t("education.title")}>
  <ol class="space-y-8">
    {education.map((e) => (
      <li class="grid gap-x-8 gap-y-1 sm:grid-cols-[10rem_minmax(0,1fr)]">
        <p class="tnum pt-0.5 text-[0.9375rem] text-ink-3">{e.period[lang]}</p>
        <div>
          <h3 class="text-lg font-semibold leading-snug">{e.school[lang]}</h3>
          <p class="text-ink-2">{e.programme[lang]}</p>
          {e.note && <p class="mt-2 text-ink-2">{e.note[lang]}</p>}
        </div>
      </li>
    ))}
  </ol>

  <dl class="mt-12 grid gap-x-10 gap-y-6 sm:grid-cols-2">
    <div>
      <dt class="font-semibold">{t("education.certs")}</dt>
      <dd class="mt-1 leading-relaxed text-ink-2">{certificates.join(", ")}</dd>
    </div>
    <div>
      <dt class="font-semibold">{t("languages.title")}</dt>
      <dd class="mt-1 leading-relaxed text-ink-2">{t("languages.list")}</dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="font-semibold">{t("life.title")}</dt>
      <dd class="mt-1 max-w-[42rem] leading-relaxed text-ink-2">{t("life.text")}</dd>
    </div>
  </dl>
</Section>
