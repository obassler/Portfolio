---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { education } from "@/data/education";
import ScrollReveal from "./ScrollReveal.astro";
import { Icon } from "astro-icon/components";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="education" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <ScrollReveal>
      <h2 class="mb-12 text-3xl font-bold sm:text-4xl">
        <span class="gradient-text">{t("education.title")}</span>
      </h2>
    </ScrollReveal>

    <div class="relative space-y-8">
      <!-- Timeline line -->
      <div class="absolute left-4 top-0 hidden h-full w-px bg-border sm:block"></div>

      {education.map((entry, i) => (
        <ScrollReveal delay={i + 1}>
          <div class="relative sm:pl-12">
            <!-- Timeline dot -->
            <div class="absolute left-2.5 top-1.5 hidden h-3 w-3 rounded-full border-2 border-pink bg-bg-primary sm:block"></div>

            <div class="rounded-xl border border-border bg-bg-card p-6 transition-colors hover:border-pink/40">
              <div class="mb-2 flex flex-wrap items-center gap-3">
                <h3 class="text-lg font-semibold text-text-primary">
                  {entry.title[lang]}
                </h3>
                <span class="rounded-full bg-pink/10 px-2.5 py-0.5 text-xs font-medium text-pink">
                  {entry.period}
                </span>
              </div>

              <p class="mb-3 flex items-center gap-1.5 text-sm text-text-muted">
                <Icon name="lucide:map-pin" class="h-3.5 w-3.5" />
                {entry.institution[lang]}
              </p>

              <p class="mb-4 text-sm leading-relaxed text-text-secondary">
                {entry.description[lang]}
              </p>

              <div class="flex flex-wrap gap-2">
                {entry.tags.map((tag) => (
                  <span class="rounded-full bg-bg-secondary px-2.5 py-0.5 text-xs text-text-muted">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
