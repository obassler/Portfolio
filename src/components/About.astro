---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import ScrollReveal from "./ScrollReveal.astro";
import { Icon } from "astro-icon/components";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const highlights = [
  { key: "about.highlight.languages" as const, icon: "lucide:code-2" },
  { key: "about.highlight.vr" as const, icon: "lucide:glasses" },
  { key: "about.highlight.ml" as const, icon: "lucide:brain" },
  { key: "about.highlight.networking" as const, icon: "lucide:network" },
];
---

<section id="about" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <ScrollReveal>
      <h2 class="mb-12 text-3xl font-bold sm:text-4xl">
        <span class="gradient-text">{t("about.title")}</span>
      </h2>
    </ScrollReveal>

    <div class="grid gap-12 lg:grid-cols-5">
      <!-- Text -->
      <div class="space-y-5 lg:col-span-3">
        <ScrollReveal>
          <p class="leading-relaxed text-text-secondary">
            {t("about.p1")}
          </p>
        </ScrollReveal>
        <ScrollReveal delay={1}>
          <p class="leading-relaxed text-text-secondary">
            {t("about.p2")}
          </p>
        </ScrollReveal>
      </div>

      <!-- Highlights grid -->
      <div class="grid grid-cols-2 gap-3 lg:col-span-2">
        {highlights.map((h, i) => (
          <ScrollReveal delay={i + 1} class="flex flex-col items-center gap-2 rounded-xl border border-border bg-bg-card p-5 text-center transition-colors hover:border-pink/40">
            <Icon name={h.icon} class="h-6 w-6 text-pink" />
            <span class="text-sm font-medium text-text-primary">{t(h.key)}</span>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </div>
</section>
