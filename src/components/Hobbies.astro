---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import ScrollReveal from "./ScrollReveal.astro";
import { Icon } from "astro-icon/components";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const hobbies = [
  {
    icon: "lucide:gamepad-2",
    title: t("hobbies.gaming"),
    description: t("hobbies.gaming.desc"),
    links: [
      { label: "Steam", href: "https://steamcommunity.com/id/onniel/", icon: "simple-icons:steam" },
      { label: "League", href: "https://www.leagueofgraphs.com/summoner/eune/Ethan%20Winters-%E6%9C%A7%E6%9C%88%E7%8B%90%E6%84%9B%E8%8A%B1", icon: "simple-icons:leagueoflegends" },
    ],
  },
  {
    icon: "lucide:tv",
    title: t("hobbies.anime"),
    description: t("hobbies.anime.desc"),
    links: [
      { label: "Anime-Planet", href: "https://www.anime-planet.com/users/Onniel", icon: "lucide:book-open" },
    ],
  },
  {
    icon: "lucide:heart",
    title: t("hobbies.other"),
    description: t("hobbies.other.desc"),
    links: [
      { label: "Spotify", href: "https://open.spotify.com/user/21hqc2iwvjlozj67wsigsqgty", icon: "simple-icons:spotify" },
    ],
  },
];
---

<section id="hobbies" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <ScrollReveal>
      <h2 class="mb-12 text-3xl font-bold sm:text-4xl">
        <span class="gradient-text">{t("hobbies.title")}</span>
      </h2>
    </ScrollReveal>

    <div class="grid gap-4 sm:grid-cols-3">
      {hobbies.map((hobby, i) => (
        <ScrollReveal delay={i + 1} class="group rounded-xl border border-border bg-bg-card p-5 transition-colors hover:border-pink/40">
          <div class="mb-3 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-pink/10 text-pink transition-colors group-hover:bg-pink/20">
              <Icon name={hobby.icon} class="h-5 w-5" />
            </div>
            <h3 class="text-base font-semibold text-text-primary">{hobby.title}</h3>
          </div>

          <p class="mb-4 text-sm leading-relaxed text-text-muted">
            {hobby.description}
          </p>

          {hobby.links.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {hobby.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full bg-bg-secondary px-3 py-1 text-xs font-medium text-text-secondary transition-colors hover:text-pink"
                >
                  <Icon name={link.icon} class="h-3.5 w-3.5" />
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
