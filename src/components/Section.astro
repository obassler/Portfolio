---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-h`} class="border-t border-rule">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-14 sm:px-8 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10 md:py-20">
    <h2 id={`${id}-h`} class="text-2xl font-bold tracking-tight md:sticky md:top-24 md:self-start">{title}</h2>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>
